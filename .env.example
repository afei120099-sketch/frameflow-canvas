# Frameflow canvas — local configuration example / 本地配置示例
#
# NOTE: the dev server and helper scripts read these from the process environment.
# They are NOT loaded from a .env file automatically. Set them in your shell
# (PowerShell: $env:FRAMEFLOW_COMFYUI_ROOT = "C:\ComfyUI_windows_portable\ComfyUI")
# or as Windows user environment variables before running `pnpm dev`.
# 注意：这些值从进程环境变量读取，不会自动读取 .env 文件。请在启动前于 PowerShell 设置，或设为 Windows 用户环境变量。
#
# Relative paths are resolved from the directory you start the server in (normally the repo root).
# 相对路径以启动目录（一般是仓库根目录）为基准。

# ---------- Data folders / 数据目录 ----------
# Root for local canvas data (inbox, snapshots, page transfer, automation). Default: ./data
FRAMEFLOW_DATA_ROOT=./data
# Inbox root (queues dropped here are picked up by the canvas). Default: <FRAMEFLOW_DATA_ROOT>/inbox
FRAMEFLOW_INBOX_ROOT=./data/inbox
# Canvas snapshots written by the inbox helper. Default: <FRAMEFLOW_DATA_ROOT>/snapshots
FRAMEFLOW_SNAPSHOT_ROOT=./data/snapshots
# Page-pack transfer folder (scripts/page-transfer-server.mjs). Default: <FRAMEFLOW_DATA_ROOT>/page-transfer
FRAMEFLOW_PAGE_TRANSFER_ROOT=./data/page-transfer
# Folders that "open containing folder" may reveal, besides ComfyUI input/output. Default: <FRAMEFLOW_DATA_ROOT>
FRAMEFLOW_DESKTOP_CANVAS_ROOT=./data
# Extra folders that may be revealed, separated by ";". Default: empty
FRAMEFLOW_EXTRA_REVEAL_ROOTS=
# Read-only roots for window.frameflow automation file access, separated by ";". Default: <FRAMEFLOW_DATA_ROOT>/automation
FRAMEFLOW_AUTOMATION_ROOTS=./data/automation
# Autopilot / production-line ledgers. Defaults: ./runtime/autopilot and ./runtime/production
FRAMEFLOW_AUTOPILOT_DIR=
FRAMEFLOW_PRODUCTION_DIR=

# ---------- ComfyUI ----------
# Your ComfyUI folder (the one that contains models/, input/, output/). Default: C:\ComfyUI_windows_portable\ComfyUI
FRAMEFLOW_COMFYUI_ROOT=C:\ComfyUI_windows_portable\ComfyUI
# ComfyUI HTTP address used by the autopilot / production workers. Default: http://127.0.0.1:8188
# (The canvas page itself always proxies /comfyui to http://127.0.0.1:8188.)
FRAMEFLOW_COMFYUI_URL=http://127.0.0.1:8188
# Python with PyAV (e.g. ComfyUI portable's python_embeded\python.exe) for rough cut / audio extract / cover compose. Default: python
FRAMEFLOW_PYAV_PYTHON=python

# ---------- Optional tools / 可选工具 ----------
# Optional external prompt-rules toolkit folder (SKILL_h3-video.md, h3q.py, 源文件/vocab.json). Not shipped with this repo.
# Without it, the shot cards simply skip the toolkit checks. Default: ./h3-tools
FRAMEFLOW_H3_TOOLS=./h3-tools
# Python used to run h3q.py. Default: python
FRAMEFLOW_PYTHON=python
# Portable Blender for the white-box director stage: path to blender.exe, or a folder that contains blender-*-windows-x64\
FRAMEFLOW_BLENDER=
FRAMEFLOW_BLENDER_SEARCH_DIR=

# ---------- Ports & instances / 端口与多开 ----------
FRAMEFLOW_INBOX_PORT=5193
FRAMEFLOW_CLAIM_PORT=8791
FRAMEFLOW_INSTANCE_ID=
FRAMEFLOW_INSTANCE_NAME=
FRAMEFLOW_PRODUCTION_OWNER=http://127.0.0.1:5173
FRAMEFLOW_VITE_CACHE=node_modules/.vite

# ---------- Autopilot director (optional) / 夜班导演（可选） ----------
# mock | local-lmstudio | claude   (see config/director-providers.json)
FRAMEFLOW_DEFAULT_DIRECTOR=
FRAMEFLOW_LMSTUDIO_URL=
FRAMEFLOW_LMSTUDIO_MODEL=
FRAMEFLOW_LMSTUDIO_TOKEN=
FRAMEFLOW_LMS_CLI=
FRAMEFLOW_CLAUDE_MODEL=
# Only needed for the "claude" director. Never commit a real key.
ANTHROPIC_API_KEY=

# ---------- Tests only / 仅测试 ----------
# Optional real queue file(s) for the extra checks in a few scripts/test-*.mjs (single file / ";"-separated list)
FRAMEFLOW_TEST_QUEUE=
FRAMEFLOW_TEST_QUEUES=
# Browser tests: path to playwright/index.mjs (default: the "playwright" package) and to a Chrome executable
FRAMEFLOW_PLAYWRIGHT_ENTRY=
FRAMEFLOW_CHROME_PATH=
