# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Autopilot ledger, logs and videos (local data, not source)
/runtime/

# Local canvas data (inbox, snapshots, page transfer)
/data/
/config.local.json

# Local-only baseline: preserve these files on disk, but do not version them.
# Nested dependencies and generated caches
node_modules/
__pycache__/
*.pyc
*.pyo
*.tsbuildinfo
*.log
.pnpm-store/
/build/runtime-fixtures/

# Machine-specific agent state, debug fixtures and local credentials
/.claude/
*.env
*.key
*.p12
*.pfx
.netrc

# Media assets and model weights stay in their original locations.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.avif
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.aac
*.safetensors
*.gguf
*.ggml
*.ckpt
*.pt
*.pth
*.onnx
*.bin
*.npz
*.npy
/models/

# Local caches and ad-hoc backups (added 2026-11-08)
/.vite-cache/
*.bak_*
*.before-*.bak
__pycache__/
